#!/bin/bash
set -euo pipefail

# ---- Variables from Terraform ----
TAILSCALE_AUTH_KEY="${tailscale_auth_key}"
SPLUNK_ADMIN_PASSWORD="${splunk_admin_password}"
SPLUNK_HEC_TOKEN="${splunk_hec_token}"

# ---- Splunk build to install ----
# x86_64 tgz (Splunk Enterprise publishes no Linux ARM64 build; all -armv8
# URLs on download.splunk.com return 404).
SPLUNK_VERSION="10.4.3"
SPLUNK_BUILD="4174a2deda5d"
# SHA512 of the pinned archive. Bump together with SPLUNK_VERSION/SPLUNK_BUILD;
# grab it from the Splunk download page (or `sha512sum` the published file).
SPLUNK_SHA512="bc034266da63bc045a38c8fbda59ad2196b405abad20e217100d6cdfc20316ff17dddb37cde875f62557fee0948554e5d93650ffec5b5b7daebc9d09ed5931e3"
SPLUNK_TGZ="splunk-$${SPLUNK_VERSION}-$${SPLUNK_BUILD}-linux-amd64.tgz"
SPLUNK_URL="https://download.splunk.com/products/splunk/releases/$${SPLUNK_VERSION}/linux/$${SPLUNK_TGZ}"

export DEBIAN_FRONTEND=noninteractive

# ---- System prep ----
# apt mirrors occasionally 503 transiently (observed twice); retry so a
# transient failure doesn't abort the whole bootstrap under `set -e`.
apt-get update -y
runcmd() { for i in 1 2 3 4 5; do "$@" && return 0; sleep 10; done; return 1; }
runcmd apt-get install -y curl wget jq gnupg2 lsb-release nvme-cli

# ---- Mount data volume (/opt/splunk-data) ----
# Nitro instances (t4g) expose EBS as NVMe, Xen (t3) as /dev/xvd*; find the
# data volume by excluding root.
DATA_MOUNT="/opt/splunk-data"
ROOT_DEV=$(findmnt -n -o SOURCE /)
ROOT_DISK=$(lsblk -no PKNAME "$${ROOT_DEV}" 2>/dev/null || basename "$${ROOT_DEV}" | sed 's/p[0-9]*$//')

# Find the first block device that isn't the root disk
DATA_DEV=""
for dev in /dev/nvme[0-9]n1 /dev/xvd[f-z]; do
  [ -b "$dev" ] || continue
  dev_name=$(basename "$dev")
  # Skip if this is the root disk
  [[ "$dev_name" == "$ROOT_DISK"* ]] && continue
  DATA_DEV="$dev"
  break
done

if [ -z "$${DATA_DEV}" ]; then
  echo "ERROR: Could not find data volume device" >&2
  exit 1
fi

echo "Using data device: $${DATA_DEV}"

if ! blkid "$${DATA_DEV}" | grep -q ext4; then
  mkfs.ext4 "$${DATA_DEV}"
fi
mkdir -p "$${DATA_MOUNT}"
# Use UUID for fstab to survive device name changes
DATA_UUID=$(blkid -s UUID -o value "$${DATA_DEV}")
echo "UUID=$${DATA_UUID}  $${DATA_MOUNT}  ext4  defaults,nofail  0  2" >> /etc/fstab
mount -a

# ---- Tailscale ----
# `--unattended` is NOT supported by the distro 'tailscale up' / 'set'
# (verified on 1.102.3; the flag exists and fails). Session state is stored
# in /var/lib/tailscale, so the node reconnects on reboot without it.
# Retry `up` a few times: right after install.sh, tailscaled can race and the
# first attempt occasionally errors.
# Unique hostname (fp-splunk-<instance-id-suffix>) so a fresh instance never
# collides with stale tailnet nodes left behind by previous deploys.
curl -fsSL https://tailscale.com/install.sh | sh
IMDS_TOKEN=$(curl -fsSL -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" http://169.254.169.254/latest/api/token)
INSTANCE_ID=$(curl -fsSL -H "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" http://169.254.169.254/latest/meta-data/instance-id)
HOST_SUFFIX=$(printf '%s' "$${INSTANCE_ID}" | cut -c3-8)
TAILNET_HOSTNAME="fp-splunk-$${HOST_SUFFIX}"
up() { tailscale up --authkey="$${TAILSCALE_AUTH_KEY}" --hostname="$${TAILNET_HOSTNAME}" --accept-routes; }
for i in 1 2 3 4 5; do up && break; sleep 5; done

# ---- Download and verify Splunk ----
cd /tmp
wget -q -O "$${SPLUNK_TGZ}" "$${SPLUNK_URL}"
# Fail the bootstrap (set -e) on any mismatch rather than extracting a bad archive.
echo "$${SPLUNK_SHA512}  $${SPLUNK_TGZ}" | sha512sum -c -
tar -xzf "$${SPLUNK_TGZ}" -C /opt
rm -f "$${SPLUNK_TGZ}"

# ---- Configure Splunk ----
SPLUNK_HOME="/opt/splunk"

# Set SPLUNK_DB to the persistent data volume
mkdir -p "$${DATA_MOUNT}/db" "$${DATA_MOUNT}/colddb" "$${DATA_MOUNT}/thaweddb"
cat > "$${SPLUNK_HOME}/etc/system/local/server.conf" <<EOF
[general]
SPLUNK_DB = $${DATA_MOUNT}/db
EOF

# Admin credentials (non-interactive first run)
cat > "$${SPLUNK_HOME}/etc/system/local/user-seed.conf" <<EOF
[user_info]
USERNAME = admin
PASSWORD = $${SPLUNK_ADMIN_PASSWORD}
EOF

# Custom indexes
cat > "$${SPLUNK_HOME}/etc/system/local/indexes.conf" <<EOF
[fp_lab_wineventlog]
homePath   = $${DATA_MOUNT}/db/fp_lab_wineventlog/db
coldPath   = $${DATA_MOUNT}/colddb/fp_lab_wineventlog/colddb
thawedPath = $${DATA_MOUNT}/thaweddb/fp_lab_wineventlog/thaweddb
maxTotalDataSizeMB = 20480

[fp_test]
homePath   = $${DATA_MOUNT}/db/fp_test/db
coldPath   = $${DATA_MOUNT}/colddb/fp_test/colddb
thawedPath = $${DATA_MOUNT}/thaweddb/fp_test/thaweddb
maxTotalDataSizeMB = 5120
EOF

# Enable UF receiving on 9997
cat > "$${SPLUNK_HOME}/etc/system/local/inputs.conf" <<EOF
[splunktcp://9997]
connection_host = ip
EOF

# HEC configuration (splunk_httpinput app local/ doesn't exist until first start).
# enableSSL=0 so plaintext HTTP over 8088 works across the encrypted tailnet.
mkdir -p "$${SPLUNK_HOME}/etc/apps/splunk_httpinput/local"
cat > "$${SPLUNK_HOME}/etc/apps/splunk_httpinput/local/inputs.conf" <<EOF
[http]
disabled = 0
port = 8088
enableSSL = 0
token = $${SPLUNK_HEC_TOKEN}

[http://fp_lab_hec]
disabled = 0
index = fp_lab_wineventlog
token = $${SPLUNK_HEC_TOKEN}
EOF

# Bind all interfaces (SG enforces no-inbound; reachable only via tailnet)
cat > "$${SPLUNK_HOME}/etc/system/local/web.conf" <<EOF
[settings]
httpport = 8000
startwebserver = 1
EOF

# ---- Start Splunk ----
"$${SPLUNK_HOME}/bin/splunk" start --accept-license --answer-yes --no-prompt
"$${SPLUNK_HOME}/bin/splunk" enable boot-start -user root
