<powershell>
# FP Lab Windows endpoint bootstrap
# Runs once at first launch via EC2 user data

$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

# ---- Variables from Terraform ----
$TailscaleAuthKey    = "${tailscale_auth_key}"
$Hostname            = "${hostname}"
$Profile             = "${profile}"
$SplunkHecToken      = "${splunk_hec_token}"
$WindowsAdminPassword = "${windows_admin_password}"

$SysmonUrl        = "https://download.sysinternals.com/files/Sysmon.zip"

$SplunkUFVersion  = "10.4.3"
$SplunkUFBuild    = "4174a2deda5d"
$SplunkUFUrl      = "https://download.splunk.com/products/universalforwarder/releases/$SplunkUFVersion/windows/splunkforwarder-$SplunkUFVersion-$SplunkUFBuild-windows-x64.msi"

$GhostsTag      = "v9.0.0"
$GhostsZipUrl   = "https://github.com/cmu-sei/GHOSTS/releases/download/$GhostsTag/ghosts-client-windows-x64.zip"
$GhostsDir      = "C:\GHOSTS"
$GhostsExe      = "$GhostsDir\x64\ghosts.exe"
$GhostsTimeline = "$GhostsDir\x64\config\timeline.json"

$TempDir = "C:\fp-lab-setup"
New-Item -ItemType Directory -Force -Path $TempDir | Out-Null

# ---- Instance ID (IMDSv2) and unique tailnet hostname ----
# Rehydration-friendly: the '-<id>' suffix means a fresh instance never
# collides with stale tailnet nodes left behind by previous deploys.
$MetadataTokenUri = "http://169.254.169.254/latest/api/token"
$MetadataToken = (Invoke-RestMethod -Method PUT -Uri $MetadataTokenUri `
    -Headers @{"X-aws-ec2-metadata-token-ttl-seconds"="21600"})
$InstanceId = (Invoke-RestMethod `
    -Uri "http://169.254.169.254/latest/meta-data/instance-id" `
    -Headers @{"X-aws-ec2-metadata-token"=$MetadataToken})
$IdSuffix = $InstanceId.Substring(2, [Math]::Min(6, $InstanceId.Length - 2))
$TailnetHostname = "${hostname}-$IdSuffix"

# ---- Rename computer ----
Rename-Computer -NewName $Hostname -Force

# ---- Administrator password + RDP ----
net user Administrator $WindowsAdminPassword
Set-ItemProperty -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" `
    -Name fDenyTSConnections -Value 0
Enable-NetFirewallRule -DisplayGroup "Remote Desktop"

# ---- Tailscale ----
$TsInstaller = "$TempDir\tailscale-setup.exe"
Invoke-WebRequest -Uri "https://pkgs.tailscale.com/stable/tailscale-setup-latest.exe" `
    -OutFile $TsInstaller -UseBasicParsing
Start-Process -FilePath $TsInstaller -ArgumentList "/S" -Wait

# Wait for Tailscale service to be running (up to 60s)
$TsSvc = $null
for ($i = 0; $i -lt 12; $i++) {
    $TsSvc = Get-Service -Name Tailscale -ErrorAction SilentlyContinue
    if ($TsSvc -and $TsSvc.Status -eq "Running") { break }
    Start-Sleep -Seconds 5
}

& "C:\Program Files\Tailscale\tailscale.exe" up --authkey="$TailscaleAuthKey" --hostname="$TailnetHostname" --accept-routes --unattended
& "C:\Program Files\Tailscale\tailscale.exe" set --unattended=true

# ---- Locate the live Splunk indexer over the tailnet ----
# We collect the indexer's tailnet IP from `tailscale status --json` rather
# than hardcoding a hostname: the indexer's name is suffixed with its instance
# ID, and stale offline nodes from prior deploys must not shadow the live one.
# Picks the first ONLINE peer whose base hostname starts with 'fp-splunk-'.
function Get-IndexerTailnetIp {
    for ($attempt = 0; $attempt -lt 60; $attempt++) {
        try {
            $status = & "C:\Program Files\Tailscale\tailscale.exe" status --json 2>$null | ConvertFrom-Json
            $peer = $status.Peer | Where-Object { $_.HostName -like "fp-splunk-*" -and $_.Online -eq $true } | Select-Object -First 1
            if ($peer -and $peer.TailscaleIPs -and $peer.TailscaleIPs[0]) {
                return $peer.TailscaleIPs[0].ToString()
            }
        } catch {
            # tailscaled may still be starting; ignore and retry
        }
        Start-Sleep -Seconds 20
    }
    return $null
}

# ---- Sysmon ----
$SysmonZip = "$TempDir\Sysmon.zip"
Invoke-WebRequest -Uri $SysmonUrl -OutFile $SysmonZip -UseBasicParsing

$SysmonDir = "$TempDir\Sysmon"
Expand-Archive -Path $SysmonZip -DestinationPath $SysmonDir -Force

# Download sysmon-modular merged config from S3 corpus bucket (instance IAM role)
$SysmonConfigPath = "$TempDir\sysmon-config.xml"
$BucketName = "fp-lab-corpora-${account_suffix}"
$S3ConfigKey = "config/sysmon-config.xml"
$AwsRegion  = "us-east-1"
$IdentityDoc = Invoke-RestMethod `
    -Uri "http://169.254.169.254/latest/dynamic/instance-identity/document" `
    -Headers @{"X-aws-ec2-metadata-token"=$MetadataToken}
$CredentialRole = (Invoke-RestMethod `
    -Uri "http://169.254.169.254/latest/meta-data/iam/security-credentials/" `
    -Headers @{"X-aws-ec2-metadata-token"=$MetadataToken})
$Creds = Invoke-RestMethod `
    -Uri "http://169.254.169.254/latest/meta-data/iam/security-credentials/$CredentialRole" `
    -Headers @{"X-aws-ec2-metadata-token"=$MetadataToken}

$Env:AWS_ACCESS_KEY_ID     = $Creds.AccessKeyId
$Env:AWS_SECRET_ACCESS_KEY = $Creds.SecretAccessKey
$Env:AWS_SESSION_TOKEN     = $Creds.Token

# Install AWS CLI for S3 download
$AwsCliMsi = "$TempDir\AWSCLIV2.msi"
Invoke-WebRequest -Uri "https://awscli.amazonaws.com/AWSCLIV2.msi" `
    -OutFile $AwsCliMsi -UseBasicParsing
Start-Process msiexec.exe -ArgumentList "/i `"$AwsCliMsi`" /qn" -Wait
$Env:PATH += ";C:\Program Files\Amazon\AWSCLIV2"

aws s3 cp "s3://$BucketName/$S3ConfigKey" $SysmonConfigPath --region $AwsRegion

& "$SysmonDir\Sysmon64.exe" -accepteula -i $SysmonConfigPath

# ---- Splunk Universal Forwarder ----
$SplunkUFMsi = "$TempDir\splunkforwarder.msi"
Invoke-WebRequest -Uri $SplunkUFUrl -OutFile $SplunkUFMsi -UseBasicParsing

Start-Process msiexec.exe -Wait -ArgumentList @(
    "/i", "`"$SplunkUFMsi`"",
    "/qn",
    "AGREETOLICENSE=Yes",
    "LAUNCHSPLUNK=0"
)

$UFHome = "C:\Program Files\SplunkUniversalForwarder"

# The UF service runs as NT SERVICE\SplunkForwarder, which lacks read access
# to third-party event log channels (e.g. Sysmon).  Add the service account to
# the built-in Event Log Readers group so it can subscribe.
Add-LocalGroupMember -Group "Event Log Readers" -Member "NT SERVICE\SplunkForwarder" -ErrorAction SilentlyContinue

# Resolve the live indexer tailnet IP before writing the forwarder config
$IndexerIp = Get-IndexerTailnetIp
if (-not $IndexerIp) {
    # Discovery can fail when the endpoint hasn't yet been approved on the
    # tailnet.  Fall back to the known MagicDNS hostname passed from Terraform
    # (always resolves to the live indexer).
    Write-Warning "Could not discover live indexer via tailscale; falling back to MagicDNS name '${indexer_tailnet_hostname}'."
    $IndexerIp = "${indexer_tailnet_hostname}"
}

# Persistent disk queue so events survive indexer downtime
@"
[tcpout]
defaultGroup = fp_splunk_indexer
persistentQueueSize = 512MB

[tcpout:fp_splunk_indexer]
server = $${IndexerIp}:9997
compressed = true
"@ | Set-Content "$UFHome\etc\system\local\outputs.conf"

# Monitor Sysmon WinEventLog channel
@"
[WinEventLog://Microsoft-Windows-Sysmon/Operational]
disabled = 0
index = fp_lab_wineventlog
renderXml = false
"@ | Set-Content "$UFHome\etc\system\local\inputs.conf"

& "$UFHome\bin\splunk.exe" start --accept-license --answer-yes --no-prompt
& "$UFHome\bin\splunk.exe" enable boot-start

# ---- GHOSTS standalone client ----
New-Item -ItemType Directory -Force -Path $GhostsDir | Out-Null

$GhostsZip = "$TempDir\ghosts-client.zip"
Invoke-WebRequest -Uri $GhostsZipUrl -OutFile $GhostsZip -UseBasicParsing
Expand-Archive -Path $GhostsZip -DestinationPath $GhostsDir -Force

# Copy profile timeline from S3 (overwrites the stock GHOSTS timeline)
New-Item -ItemType Directory -Force -Path "$GhostsDir\x64\config" | Out-Null
aws s3 cp "s3://$BucketName/config/ghosts-timeline-$Profile.json" $GhostsTimeline --region $AwsRegion
if ($LASTEXITCODE -ne 0) {
    Write-Warning "Timeline download from S3 failed; GHOSTS will run its stock sample timeline."
}

# Register GHOSTS as a scheduled task that runs at startup.
# Run as SYSTEM (LogonType ServiceAccount) so start-at-boot works without
# stored credentials, and launch from the install dir with the config path so
# GHOSTS finds its config/timeline. ExecutionTimeLimit=0 = run indefinitely.
$Action  = New-ScheduledTaskAction -Execute $GhostsExe `
    -Argument "--config=$GhostsDir\x64\config\application.json" `
    -WorkingDirectory "$GhostsDir\x64"
$Trigger = New-ScheduledTaskTrigger -AtStartup
$Settings = New-ScheduledTaskSettingsSet -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 5) `
    -ExecutionTimeLimit ([TimeSpan]::Zero)
$Principal = New-ScheduledTaskPrincipal -UserId "NT AUTHORITY\SYSTEM" `
    -LogonType ServiceAccount -RunLevel Highest
Register-ScheduledTask -TaskName "GHOSTS" -Action $Action -Trigger $Trigger `
    -Settings $Settings -Principal $Principal -Force

Start-ScheduledTask -TaskName "GHOSTS"

# ---- Action1 agent ----
# MSI embeds the org customer ID + client cert/key, so a silent install is
# all that's needed to register with the Action1 cloud.
$Action1Msi = "$TempDir\action1_agent.msi"
aws s3 cp "s3://$BucketName/software/action1_agent.msi" $Action1Msi --region $AwsRegion
if ($LASTEXITCODE -eq 0) {
    $a1p = Start-Process msiexec.exe -Wait -PassThru -ArgumentList "/i `"$Action1Msi`" /qn /norestart"
    if ($a1p.ExitCode -eq 0) {
        Write-Output "Action1 agent installed"
    } else {
        Write-Warning "Action1 agent install exited $($a1p.ExitCode)"
    }
} else {
    Write-Warning "Action1 MSI download from S3 failed; skipping agent install."
}

# ---- Velociraptor client ----
# MSI embeds the server URL, CA cert, and enrollment nonce in client.config.yaml,
# and registers the client as a LocalSystem service.
$VelociraptorMsi = "$TempDir\velociraptor-personal-2026-09-08.msi"
aws s3 cp "s3://$BucketName/software/velociraptor-personal-2026-09-08.msi" $VelociraptorMsi --region $AwsRegion
if ($LASTEXITCODE -eq 0) {
    $vp = Start-Process msiexec.exe -Wait -PassThru -ArgumentList "/i `"$VelociraptorMsi`" /qn /norestart"
    if ($vp.ExitCode -eq 0) {
        Write-Output "Velociraptor client installed"
    } else {
        Write-Warning "Velociraptor client install exited $($vp.ExitCode)"
    }
} else {
    Write-Warning "Velociraptor MSI download from S3 failed; skipping agent install."
}

# ---- Cleanup ----
Remove-Item -Recurse -Force $TempDir

# Reboot to apply hostname change
Restart-Computer -Force
</powershell>